# nginx config for the Trajectory Action Container console.
# Rendered at container start by the official nginx image's envsubst step,
# which fills ${ACTIONS_API_UPSTREAM} (e.g. http://actions-server:3002).
# nginx runtime vars ($host, $uri) are NOT env vars, so they are preserved.

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # REST API: proxy to the Action Container server. proxy_buffering off and a
    # long read timeout keep Server-Sent Events (SSE) streaming endpoints alive.
    location /trajectory/ {
        proxy_pass ${ACTIONS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /management/ {
        proxy_pass ${ACTIONS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # SPA client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }
}
